# Convex deployment URL (shared with the altar website)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Google OAuth client IDs (set up via Google Cloud Console)
# webClientId is used by Android + as the audience for verifying the idToken
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com

# Migration script only (one-time, do NOT ship these into the app bundle)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CONVEX_URL=
